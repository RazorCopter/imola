# ---------------------------------------------------------------------------
# Supplier Ledger - variabili di ambiente
# Copiare in .env e compilare. Nessun segreto va nel repository.
# ---------------------------------------------------------------------------

# --- Django ---------------------------------------------------------------
# Generare con: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=cambiami-con-una-chiave-casuale-lunga
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,supplier-ledger.mediolanum.local
CSRF_TRUSTED_ORIGINS=http://localhost:8080,https://supplier-ledger.mediolanum.local
# True solo quando il reverse proxy espone HTTPS (obbligatorio in produzione).
COOKIE_SECURE=False
LOG_LEVEL=INFO
SESSION_COOKIE_AGE=28800

# --- Database -------------------------------------------------------------
POSTGRES_DB=supplier_ledger
POSTGRES_USER=supplier_ledger
POSTGRES_PASSWORD=cambiami
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Percorsi e porte -----------------------------------------------------
# Su Synology: /volume1/docker/supplier-ledger
SL_DATA_DIR=./.docker-data
SL_HTTP_PORT=8080
SL_BACKEND_PORT=8000
SL_FRONTEND_PORT=5173
SL_DB_PORT=5433

# --- Dominio --------------------------------------------------------------
# R2: anni di validita del residuo dopo la chiusura della consuntivazione.
RESIDUAL_EXPIRING_WINDOW_DAYS=90
MAX_UPLOAD_BYTES=26214400
LOGIN_THROTTLE_RATE=10/min

# --- Autenticazione -------------------------------------------------------
# local in v1; entra_id e predisposto ma non attivo.
AUTH_PROVIDER=local

# --- Frontend (build) -----------------------------------------------------
VITE_API_BASE_URL=/api/v1
